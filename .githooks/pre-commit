#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
GENERATOR="$ROOT/ia_risc_v_npu/src/scripts/generate_cq_models.py"
TARGET_DIR="ia_risc_v_npu/src/src/cq/generated"

if [ ! -f "$GENERATOR" ]; then
  echo "CQ codegen script not found: $GENERATOR" >&2
  exit 1
fi

python "$GENERATOR" >/dev/null

if ! git diff --quiet -- "$TARGET_DIR"; then
  echo "CQ generated helpers updated. Please review and stage changes." >&2
  git status --short -- "$TARGET_DIR"
  exit 1
fi
